{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/gen-retry/action-protocol-v0.3.schema.json",
  "title": "Gen-Retry Planner Action v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "arguments"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "action": {
      "enum": [
        "query_skill",
        "generate_image",
        "edit_image",
        "submit_attempt"
      ]
    },
    "arguments": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "action": {
          "const": "query_skill"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill_ids",
            "target_constraint_ids"
          ],
          "properties": {
            "skill_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              }
            },
            "target_constraint_ids": {
              "$ref": "#/$defs/constraintIds"
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "generate_image"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "decision_summary",
            "diagnostic_hypotheses",
            "interventions",
            "target_constraint_ids",
            "preserve_constraint_ids",
            "skill_ids_used",
            "generation_instruction"
          ],
          "properties": {
            "mode": {
              "enum": [
                "initial",
                "regenerate"
              ]
            },
            "decision_summary": {
              "$ref": "#/$defs/decisionSummary"
            },
            "diagnostic_hypotheses": {
              "$ref": "#/$defs/diagnosticHypotheses"
            },
            "interventions": {
              "$ref": "#/$defs/interventions"
            },
            "target_constraint_ids": {
              "$ref": "#/$defs/constraintIds"
            },
            "preserve_constraint_ids": {
              "$ref": "#/$defs/constraintIdsAllowEmpty"
            },
            "skill_ids_used": {
              "$ref": "#/$defs/skillIds"
            },
            "generation_instruction": {
              "type": "string",
              "minLength": 10,
              "maxLength": 2400
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "edit_image"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_attempt_id",
            "decision_summary",
            "diagnostic_hypotheses",
            "interventions",
            "target_constraint_ids",
            "preserve_constraint_ids",
            "skill_ids_used",
            "edit_instruction"
          ],
          "properties": {
            "source_attempt_id": {
              "$ref": "#/$defs/attemptId"
            },
            "decision_summary": {
              "$ref": "#/$defs/decisionSummary"
            },
            "diagnostic_hypotheses": {
              "$ref": "#/$defs/diagnosticHypotheses"
            },
            "interventions": {
              "$ref": "#/$defs/interventions"
            },
            "target_constraint_ids": {
              "$ref": "#/$defs/constraintIds"
            },
            "preserve_constraint_ids": {
              "$ref": "#/$defs/constraintIdsAllowEmpty"
            },
            "skill_ids_used": {
              "$ref": "#/$defs/skillIds"
            },
            "edit_instruction": {
              "type": "string",
              "minLength": 10,
              "maxLength": 2400
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "submit_attempt"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected_attempt_id",
            "reason_code",
            "decision_summary"
          ],
          "properties": {
            "selected_attempt_id": {
              "$ref": "#/$defs/attemptId"
            },
            "reason_code": {
              "enum": [
                "all_constraints_passed",
                "best_available_under_budget",
                "no_productive_action_remaining"
              ]
            },
            "decision_summary": {
              "$ref": "#/$defs/decisionSummary"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "attemptId": {
      "type": "string",
      "pattern": "^a_[0-9]{3,}$"
    },
    "constraintIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^c_[0-9]{3,}$"
      }
    },
    "constraintIdsAllowEmpty": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^c_[0-9]{3,}$"
      }
    },
    "decisionSummary": {
      "type": "string",
      "minLength": 12,
      "maxLength": 320
    },
    "diagnosticHypotheses": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/diagnosticHypothesis"
      }
    },
    "diagnosticHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_ids",
        "visual_targets",
        "hypothesis"
      ],
      "properties": {
        "constraint_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^c_[0-9]{3,}$"
          }
        },
        "visual_targets": {
          "$ref": "#/$defs/visualTargets"
        },
        "hypothesis": {
          "type": "string",
          "minLength": 12,
          "maxLength": 360
        }
      }
    },
    "interventions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/intervention"
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "target_constraint_ids",
        "visual_targets",
        "change"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "target_constraint_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^c_[0-9]{3,}$"
          }
        },
        "visual_targets": {
          "$ref": "#/$defs/visualTargets"
        },
        "change": {
          "type": "string",
          "minLength": 12,
          "maxLength": 480
        }
      }
    },
    "operation": {
      "enum": [
        "instance_count_layout",
        "spatial_relation_layout",
        "action_pose_cue",
        "attribute_binding"
      ]
    },
    "visualTargets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "skillIds": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      }
    }
  }
}
