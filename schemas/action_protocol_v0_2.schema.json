{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/gen-retry/action-protocol-v0.2.schema.json",
  "title": "Gen-Retry Planner Action v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "arguments"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "action": {
      "enum": [
        "query_skill",
        "generate_image",
        "edit_image",
        "submit_attempt"
      ]
    },
    "arguments": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "action": {
          "const": "query_skill"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill_ids",
            "target_constraint_ids"
          ],
          "properties": {
            "skill_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "target_constraint_ids": {
              "$ref": "#/$defs/constraintIds"
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "generate_image"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "target_constraint_ids",
            "preserve_constraint_ids",
            "strategy_tags",
            "skill_ids_used",
            "generation_instruction"
          ],
          "properties": {
            "mode": {
              "enum": [
                "initial",
                "regenerate"
              ]
            },
            "target_constraint_ids": {
              "$ref": "#/$defs/constraintIds"
            },
            "preserve_constraint_ids": {
              "$ref": "#/$defs/constraintIdsAllowEmpty"
            },
            "strategy_tags": {
              "$ref": "#/$defs/strategyTags"
            },
            "skill_ids_used": {
              "$ref": "#/$defs/skillIds"
            },
            "generation_instruction": {
              "type": "string",
              "minLength": 10,
              "maxLength": 2400
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "edit_image"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_attempt_id",
            "target_constraint_ids",
            "preserve_constraint_ids",
            "strategy_tags",
            "skill_ids_used",
            "edit_instruction"
          ],
          "properties": {
            "source_attempt_id": {
              "$ref": "#/$defs/attemptId"
            },
            "target_constraint_ids": {
              "$ref": "#/$defs/constraintIds"
            },
            "preserve_constraint_ids": {
              "$ref": "#/$defs/constraintIdsAllowEmpty"
            },
            "strategy_tags": {
              "$ref": "#/$defs/strategyTags"
            },
            "skill_ids_used": {
              "$ref": "#/$defs/skillIds"
            },
            "edit_instruction": {
              "type": "string",
              "minLength": 10,
              "maxLength": 2400
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "submit_attempt"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected_attempt_id",
            "reason_code"
          ],
          "properties": {
            "selected_attempt_id": {
              "$ref": "#/$defs/attemptId"
            },
            "reason_code": {
              "enum": [
                "all_constraints_passed",
                "best_available_under_budget",
                "no_productive_action_remaining"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "attemptId": {
      "type": "string",
      "pattern": "^a_[0-9]{3,}$"
    },
    "constraintIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^c_[0-9]{3,}$"
      }
    },
    "constraintIdsAllowEmpty": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^c_[0-9]{3,}$"
      }
    },
    "strategyTags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skillIds": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
