{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/gen-retry/planner-view-v0.2.schema.json",
  "title": "Gen-Retry Planner View v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "task_spec_ref",
    "latest_attempt",
    "best_attempt",
    "latest_transition",
    "compact_history",
    "remaining_budget",
    "tool_manifest",
    "skill_manifest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "task_spec_ref": {
      "type": "string",
      "minLength": 1
    },
    "visible_images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/imageRef"
      },
      "default": []
    },
    "latest_attempt": {
      "anyOf": [
        {
          "$ref": "#/$defs/attemptSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "best_attempt": {
      "anyOf": [
        {
          "$ref": "#/$defs/attemptSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "latest_transition": {
      "anyOf": [
        {
          "$ref": "#/$defs/transition"
        },
        {
          "type": "null"
        }
      ]
    },
    "constraint_state": {
      "type": "object",
      "propertyNames": {
        "pattern": "^c_[0-9]{3,}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/constraintStatus"
      },
      "default": {}
    },
    "compact_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attemptSummary"
      }
    },
    "remaining_budget": {
      "type": "integer",
      "minimum": 0
    },
    "tool_manifest": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/toolManifestEntry"
      }
    },
    "skill_manifest": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skillManifestEntry"
      }
    },
    "retrieved_experiences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experienceSummary"
      },
      "default": []
    }
  },
  "$defs": {
    "attemptId": {
      "type": "string",
      "pattern": "^a_[0-9]{3,}$"
    },
    "constraintIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^c_[0-9]{3,}$"
      }
    },
    "imageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "display_id",
        "role"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^img_[0-9]{3,}$"
        },
        "display_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "latest",
            "best",
            "source",
            "submitted"
          ]
        },
        "attempt_id": {
          "$ref": "#/$defs/attemptId"
        }
      }
    },
    "attemptSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "image_artifact_id",
        "passed_constraint_ids",
        "failed_constraint_ids"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/attemptId"
        },
        "parent_attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/attemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "image_artifact_id": {
          "type": "string",
          "pattern": "^img_[0-9]{3,}$"
        },
        "action_type": {
          "enum": [
            "generate_image",
            "edit_image"
          ]
        },
        "passed_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "failed_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed",
        "regressed",
        "persistent_failed",
        "stable_pass"
      ],
      "properties": {
        "from_attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/attemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "to_attempt_id": {
          "$ref": "#/$defs/attemptId"
        },
        "fixed": {
          "$ref": "#/$defs/constraintIds"
        },
        "regressed": {
          "$ref": "#/$defs/constraintIds"
        },
        "persistent_failed": {
          "$ref": "#/$defs/constraintIds"
        },
        "stable_pass": {
          "$ref": "#/$defs/constraintIds"
        },
        "new_failed": {
          "$ref": "#/$defs/constraintIds"
        }
      }
    },
    "constraintStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "uncertain",
            "not_evaluated"
          ]
        },
        "latest_observed": {
          "type": "string"
        },
        "attempt_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attemptId"
          }
        }
      }
    },
    "toolManifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "action"
      ],
      "properties": {
        "tool_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "query_skill",
            "generate_image",
            "edit_image",
            "submit_attempt"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "skillManifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "version"
      ],
      "properties": {
        "skill_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "experienceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experience_id",
        "failure_signature"
      ],
      "properties": {
        "experience_id": {
          "type": "string",
          "minLength": 1
        },
        "failure_signature": {
          "type": "string",
          "minLength": 1
        },
        "preferred_action": {
          "enum": [
            "query_skill",
            "generate_image",
            "edit_image",
            "submit_attempt"
          ]
        },
        "support_count": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "maxLength": 400
        }
      }
    }
  }
}
