{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/gen-retry/planner-context-v0.4.schema.json",
  "title": "Gen-Retry PlannerContext v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_context",
    "latest_observation",
    "skill_context",
    "episode_memory",
    "runtime_state"
  ],
  "properties": {
    "task_context": {
      "$ref": "#/$defs/taskContext"
    },
    "latest_observation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/latestObservation"
        }
      ]
    },
    "skill_context": {
      "$ref": "#/$defs/skillContext"
    },
    "episode_memory": {
      "$ref": "#/$defs/episodeMemory"
    },
    "runtime_state": {
      "$ref": "#/$defs/runtimeState"
    }
  },
  "$defs": {
    "constraintIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^c_[0-9]{3,}$"
      },
      "uniqueItems": true
    },
    "taskContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_prompt", "max_image_attempts", "atom_constraints"],
      "properties": {
        "original_prompt": {
          "type": "string"
        },
        "max_image_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "atom_constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "constraint_id",
              "constraint_type",
              "requirement",
              "evaluator_question"
            ],
            "properties": {
              "constraint_id": {
                "type": "string",
                "pattern": "^c_[0-9]{3,}$"
              },
              "constraint_type": {
                "type": "string"
              },
              "requirement": {
                "type": "string"
              },
              "evaluator_question": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    "latestObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "constraint_results"],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^a_[0-9]{3,}$"
        },
        "constraint_results": {
          "$ref": "#/$defs/constraintResults"
        }
      }
    },
    "constraintResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed_constraint_ids",
        "failed_constraint_ids",
        "uncertain_constraint_ids",
        "observations"
      ],
      "properties": {
        "passed_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "failed_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "uncertain_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["constraint_id", "observed_value"],
            "properties": {
              "constraint_id": {
                "type": "string",
                "pattern": "^c_[0-9]{3,}$"
              },
              "observed_value": {
                "type": ["string", "number", "boolean", "null"]
              }
            }
          }
        }
      }
    },
    "skillContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_skills"],
      "properties": {
        "active_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill_id",
              "target_constraint_ids",
              "guidance",
              "guidance_level"
            ],
            "properties": {
              "skill_id": {
                "type": "string",
                "minLength": 1
              },
              "target_constraint_ids": {
                "$ref": "#/$defs/constraintIds"
              },
              "guidance": {
                "type": "string"
              },
              "guidance_level": {
                "enum": ["full", "summary"]
              }
            }
          }
        }
      }
    },
    "episodeMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recent_round", "earlier_rounds", "best_attempt"],
      "properties": {
        "recent_round": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/recentRound"
            }
          ]
        },
        "earlier_rounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/earlierRound"
          }
        },
        "best_attempt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bestAttempt"
            }
          ]
        }
      }
    },
    "recentRound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_queries",
        "image_action",
        "result_attempt_id",
        "observed_outcome"
      ],
      "properties": {
        "skill_queries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skillQuery"
          }
        },
        "image_action": {
          "$ref": "#/$defs/roundImageAction"
        },
        "result_attempt_id": {
          "type": "string",
          "pattern": "^a_[0-9]{3,}$"
        },
        "observed_outcome": {
          "$ref": "#/$defs/observedOutcome"
        }
      }
    },
    "earlierRound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "source_attempt_id",
        "result_attempt_id",
        "decision_summary",
        "target_constraint_ids",
        "preserve_constraint_ids",
        "outcome_summary"
      ],
      "properties": {
        "action": {
          "enum": ["generate_image", "edit_image"]
        },
        "source_attempt_id": {
          "type": ["string", "null"],
          "pattern": "^a_[0-9]{3,}$"
        },
        "result_attempt_id": {
          "type": "string",
          "pattern": "^a_[0-9]{3,}$"
        },
        "decision_summary": {
          "type": "string"
        },
        "target_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "preserve_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "outcome_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fixed_constraint_ids",
            "regressed_constraint_ids",
            "persistent_failed_constraint_ids",
            "became_best"
          ],
          "properties": {
            "fixed_constraint_ids": {
              "$ref": "#/$defs/constraintIds"
            },
            "regressed_constraint_ids": {
              "$ref": "#/$defs/constraintIds"
            },
            "persistent_failed_constraint_ids": {
              "$ref": "#/$defs/constraintIds"
            },
            "became_best": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "skillQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "target_constraint_ids"],
      "properties": {
        "skill_id": {
          "type": "string",
          "minLength": 1
        },
        "target_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        }
      }
    },
    "roundImageAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "source_attempt_id",
        "decision_summary",
        "diagnosis_summary",
        "target_constraint_ids",
        "preserve_constraint_ids",
        "instruction"
      ],
      "properties": {
        "action": {
          "enum": ["generate_image", "edit_image"]
        },
        "source_attempt_id": {
          "type": ["string", "null"],
          "pattern": "^a_[0-9]{3,}$"
        },
        "decision_summary": {
          "type": "string"
        },
        "diagnosis_summary": {
          "type": ["string", "null"]
        },
        "target_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "preserve_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "instruction": {
          "type": "string"
        }
      }
    },
    "observedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_attempt_id",
        "initial_passed_constraint_ids",
        "initial_failed_constraint_ids",
        "initial_uncertain_constraint_ids",
        "fixed_constraint_ids",
        "regressed_constraint_ids",
        "persistent_failed_constraint_ids",
        "preserved_constraint_ids",
        "new_uncertain_constraint_ids",
        "became_best"
      ],
      "properties": {
        "comparison_attempt_id": {
          "type": ["string", "null"],
          "pattern": "^a_[0-9]{3,}$"
        },
        "initial_passed_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "initial_failed_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "initial_uncertain_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "fixed_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "regressed_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "persistent_failed_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "preserved_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "new_uncertain_constraint_ids": {
          "$ref": "#/$defs/constraintIds"
        },
        "became_best": {
          "type": "boolean"
        }
      }
    },
    "bestAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "same_as_latest", "constraint_results"],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^a_[0-9]{3,}$"
        },
        "same_as_latest": {
          "type": "boolean"
        },
        "constraint_results": {
          "$ref": "#/$defs/constraintResults"
        }
      }
    },
    "runtimeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remaining_image_budget", "available_actions"],
      "properties": {
        "remaining_image_budget": {
          "type": "integer",
          "minimum": 0
        },
        "available_actions": {
          "type": "array",
          "items": {
            "enum": [
              "query_skill",
              "generate_image",
              "edit_image",
              "submit_attempt"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
