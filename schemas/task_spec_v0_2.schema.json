{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/gen-retry/task-spec-v0.2.schema.json",
  "title": "Gen-Retry TaskSpec v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "original_prompt",
    "constraints",
    "max_image_attempts"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "original_prompt": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "constraint_id",
          "constraint_type",
          "requirement"
        ],
        "properties": {
          "constraint_id": {
            "type": "string",
            "pattern": "^c_[0-9]{3,}$"
          },
          "constraint_type": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "evaluator_question": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3
          }
        }
      }
    },
    "max_image_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  }
}
